{
  "name": "claude-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:web && concurrently -n web,server -c blue,green \"vite build --watch\" \"tsx src/server.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server.ts",
    "build:web": "vite build",
    "start": "tsx src/server.ts",
    "bulk-done": "tsx scripts/bulk-done.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^12.9.0",
    "diff": "^9.0.0",
    "fastify": "^5.0.0",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "mermaid": "^11.16.0",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
